# Names only. Copy to backend/.env (gitignored) and fill in locally. Never commit real values.

# --- Application (shared with the REST API) ---
DATABASE_URL=
S3_BUCKET=
S3_PREFIX=
# Prefer 127.0.0.1 over localhost on Windows/WSL: localhost may resolve to ::1, where a stale wslrelay can hold the port
S3_ENDPOINT_URL=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- MCP server (python -m mcp_server) ---
# development | test | anything else (production-like: refuses to start unless overridden below)
BRAIN_ENV=
# Required when BRAIN_ENV is not development/test, together with BRAIN_MCP_ALLOW_PRODUCTION=true
BRAIN_MCP_ALLOW_PRODUCTION=
# Identity recorded on writes. Defaults to "claude-code-dev" in development only.
BRAIN_MCP_ACTOR=
# Write tools (brain_update_item, brain_add_note) are OFF unless this is "true"
BRAIN_MCP_ALLOW_WRITES=
# Sliding-window cap on write calls per minute (default 30)
BRAIN_MCP_WRITE_RATE_PER_MINUTE=
# Optional: override the Python interpreter used by scripts/mcp-server.mjs
BRAIN_MCP_PYTHON=
